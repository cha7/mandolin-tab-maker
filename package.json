{
  "name": "mandolin-tab-maker",
  "version": "0.0.1",
  "private": true,
  "description": "Pull the melody out of a YouTube recording and arrange it as a mandolin tab, on your own computer.",
  "scripts": {
    "prebuild": "node scripts/check-node.cjs",
    "build": "next build",
    "predev": "node scripts/check-node.cjs",
    "dev": "next dev --hostname 127.0.0.1 --port 8765",
    "preeval": "node scripts/check-node.cjs",
    "eval": "node scripts/uv.cjs run mtab eval eval/songs.yaml",
    "postinstall": "node scripts/setup-python.cjs",
    "presetup:python": "node scripts/check-node.cjs",
    "setup:python": "node scripts/setup-python.cjs",
    "prestart": "node scripts/check-node.cjs",
    "start": "next start --hostname 127.0.0.1 --port 8765",
    "pretab": "node scripts/check-node.cjs",
    "tab": "node scripts/uv.cjs run mtab run",
    "pretest": "node scripts/check-node.cjs",
    "test": "vitest run && node scripts/uv.cjs run pytest",
    "pretest:fast": "node scripts/check-node.cjs",
    "test:fast": "vitest run && node scripts/uv.cjs run pytest --deselect tests/test_end_to_end.py",
    "ui:update": "npm install --no-save @cha7/feather-heavy-design-system@latest && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ui-vendor.mjs",
    "uv": "node scripts/uv.cjs"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
